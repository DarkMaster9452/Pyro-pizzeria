# Neon Postgres — used by the app at runtime (serverless driver over HTTPS)
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"

# Auth.js (NextAuth v5)
# Generate a secret with: openssl rand -base64 32
AUTH_SECRET="change-me"
# Required so Auth.js trusts the deployment host (Vercel sets this automatically,
# but keep it for other hosts / previews)
AUTH_TRUST_HOST="true"

# Public base URL of the deployment. Used to build links inside emails
# (password reset). Never derived from the request Host header, which can be
# spoofed. On Vercel, VERCEL_PROJECT_PRODUCTION_URL is used as a fallback.
NEXT_PUBLIC_SITE_URL="https://your-domain.sk"

# --- Staff accounts -------------------------------------------------------
# The built-in staff accounts (admin@…, kuchar@…, drivers, call) are created
# once with a shared bootstrap password. The default in the source is weak and
# public, so in PRODUCTION no staff account is created unless you set one of
# the two variables below. Existing accounts are never overwritten either way.
#
# Preferred: give the bootstrap a strong password of your own, then change each
# account's password individually after its first login.
STAFF_BOOTSTRAP_PASSWORD=""
# Escape hatch: seed with the weak in-source password for a one-off bootstrap.
# Rotate every password immediately afterwards and unset this again.
SEED_DEMO_STAFF="false"

# --- Bot protection (Cloudflare Turnstile) --------------------------------
# Both required to switch the CAPTCHA on. With them unset the widget is not
# rendered and the server-side check is skipped, so the app still runs locally.
# Protects: login, registration, order creation, password-reset requests.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Transactional email (Resend) -----------------------------------------
# Both required for password-reset links and new-device login alerts to
# actually be delivered. Without them those emails are silently skipped
# (a warning is logged) — password reset will NOT work.
RESEND_API_KEY=""
MAIL_FROM="Pyro & Polomárik <noreply@your-domain.sk>"

# --- Rate limiting (optional upgrade) -------------------------------------
# When set, rate limiting uses Upstash Redis (atomic, off the primary database)
# instead of the built-in Postgres counter. Falls back to Postgres on any error.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Optional integrations (not required to run) ---
NEXT_PUBLIC_MAPBOX_TOKEN=""
CLOUDINARY_URL=""
