# Neon Postgres — used by the app at runtime (serverless driver over HTTPS)
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"

# Auth.js (NextAuth v5)
# Generate a secret with: openssl rand -base64 32
AUTH_SECRET="change-me"
# Required so Auth.js trusts the deployment host (Vercel sets this automatically,
# but keep it for other hosts / previews)
AUTH_TRUST_HOST="true"

# --- Optional integrations (not required to run) ---
NEXT_PUBLIC_MAPBOX_TOKEN=""
CLOUDINARY_URL=""
