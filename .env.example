# Database (Prisma / PostgreSQL) — used when you wire the reference schema in.
DATABASE_URL="postgresql://user:password@localhost:5432/pyro?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# OAuth providers (Google / Apple login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# Maps (address autocomplete / delivery zone polygons)
NEXT_PUBLIC_MAPBOX_TOKEN=""
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""

# Media uploads
UPLOADTHING_TOKEN=""
CLOUDINARY_URL=""

# Notifications (SMS / email / push)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
RESEND_API_KEY=""
